# ============================================================
# ShopNexa - Environment Variables
# ============================================================
# IMPORTANT: Never commit this file to version control!
# Add .env.local to your .gitignore file.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ShopNexa

# --- Supabase (Database & Auth) ---
# Get these from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Authentication ---
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# --- Razorpay (Payment Gateway) ---
# Get these from: https://dashboard.razorpay.com → Settings → API Keys
# Use TEST keys for development, LIVE keys for production
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Admin ---
# Change this to a secure password before going live!
ADMIN_EMAIL=admin@shopnexa.in
ADMIN_PASSWORD=Admin@ShopNexa123

# --- Email (Optional - for order confirmations) ---
# Supports Resend, SendGrid, or SMTP
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@shopnexa.in

# --- Image Storage (Optional) ---
# Supabase Storage is used by default (free tier)
# Set this to use a custom CDN if needed
NEXT_PUBLIC_IMAGE_CDN_URL=

# --- Rate Limiting (Optional) ---
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
